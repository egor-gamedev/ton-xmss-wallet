{
    "name": "ton-xmss-wallet",
    "version": "0.1.0",
    "description": "Post-quantum (hash-based XMSS / WOTS+) wallet smart contract for TON, with a TypeScript SDK for key generation, signing and deployment.",
    "license": "MIT",
    "private": true,
    "main": "dist/src/index.js",
    "types": "dist/src/index.d.ts",
    "keywords": [
        "ton",
        "wallet",
        "smart-contract",
        "func",
        "post-quantum",
        "xmss",
        "wots",
        "hash-based-signatures"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "create-wallet": "ts-node scripts/create-wallet.ts",
        "example": "ts-node examples/quickstart.ts",
        "build": "blueprint build xmss_wallet",
        "test": "jest --verbose",
        "typecheck": "tsc --noEmit",
        "bp": "blueprint run",
        "keygen": "ts-node scripts/keygen.ts",
        "status": "ts-node scripts/status.ts",
        "deploy": "blueprint run deploy",
        "transfer": "blueprint run transfer",
        "whitelist": "blueprint run whitelist",
        "rotate": "blueprint run rotate"
    },
    "devDependencies": {
        "@ton/blueprint": "^0.38.0",
        "@ton/core": "^0.63.1",
        "@ton/crypto": "^3.3.0",
        "@ton/sandbox": "^0.35.1",
        "@ton/test-utils": "^0.9.0",
        "@ton/ton": "^15.3.1",
        "@types/jest": "^29.5.0",
        "@types/node": "^20.19.39",
        "jest": "^29.7.0",
        "prettier": "^2.8.6",
        "ts-jest": "^29.0.5",
        "ts-node": "^10.9.1",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "bip39": "^3.1.0"
    },
    "overrides": {
        "@ton-community/func-js-bin": "0.4.5-tvmbeta.3",
        "@ton-community/func-js": "0.7.0"
    }
}
