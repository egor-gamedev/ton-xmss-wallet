#pragma version =0.4.4;
#include "imports/stdlib.fc";

;; ============================================================
;; XMSS / WOTS+ WALLET  (storage v3)
;; blinded keys: on-chain store hash(tag || preimage),
;; transaction carries only 256-bit preimage
;;
;; recv_external, before accept_message (free for the wallet):
;;   every check that does not need the WOTS+ signature —
;;   lock, seqno, wallet_id, valid_until, policy, request type,
;;   leaf / blinded-key budget, proof header, blinded key lookup.
;;
;; Right after accept_message the attempt is made permanent and
;; committed BEFORE the expensive verification (like seqno in
;; standard wallets): seqno, leaf and blinded key are burned.
;; A failed or forged message therefore costs the wallet at most
;; one verification and can never be replayed, and a published
;; WOTS+ leaf is never asked to sign a second digest.
;; The last leaf is reserved for rotate_root and is never burned;
;; a failure there locks externals until that message expires.
;;
;; blinded_remaining is a trusted counter stored alongside the
;; dict; it is NOT re-verified on every load (no udict_count).
;; It is verified only during rotate_root where the new dict
;; is supplied in the payload and the count must match exactly.
;; ============================================================

const int ALLOW_EXTERNAL = 1;
const int MIN_INTERNAL_MSG_VALUE = 50000000;

const int err::invalid_seqno        = 133;
const int err::invalid_wallet_id    = 134;
const int err::invalid_signature    = 135;
const int err::expired              = 136;
const int err::invalid_op           = 138;
const int err::policy_mismatch      = 148;
const int err::invalid_leaf_index   = 151;
const int err::wallet_exhausted     = 153;
const int err::invalid_proof_format = 154;
const int err::bad_storage          = 156;
const int err::bad_mode             = 157;
const int err::not_whitelisted      = 158;
const int err::insufficient_value   = 159;
const int err::invalid_blinded_key  = 160;
const int err::externals_locked     = 161;
const int err::leaf_reserved        = 162;

const int op::signed_external = 0x7369676E;  ;; "sign"
const int op::signed_internal = 0x73696E74;  ;; "sint"

const int req::transfer    = 0x00;
const int req::rotate_root = 0x01;
const int req::wl_add      = 0x02;
const int req::wl_remove   = 0x03;

const int AUTH_EXTERNAL = 1;
const int AUTH_INTERNAL = 2;

const int tag::wots_chain   = 0x574F4348;
const int tag::ltree        = 0x4C545245;
const int tag::merkle       = 0x4D52544C;
const int tag::xmss_msg     = 0x584D5347;
const int tag::wl_key       = 0x574C4954;
const int tag::blinded_key  = 0x424C4E44;

const int PROOF_VERSION = 0x01;

const int WOTS_W        = 16;
const int WOTS_LEN1     = 64;
const int WOTS_LEN2     = 3;
const int WOTS_LEN      = 67;
const int WOTS_CSUM_MAX = WOTS_LEN1 * (WOTS_W - 1);

const int TREE_HEIGHT      = 7;
const int TREE_MAX_LEAVES  = 128;
const int MAX_VALID_UNTIL_DELTA = 86400;

const int WL_KEY_BITS      = 256;
const int BLINDED_KEY_BITS = 256;

;; ── helpers ──────────────────────────────────────────────────

int commit_blinded_key(int preimage) inline {
    return cell_hash(
        begin_cell()
            .store_uint(tag::blinded_key, 32)
            .store_uint(preimage, 256)
        .end_cell()
    );
}

;; ── WOTS+ / Merkle ───────────────────────────────────────────

int chain_step(int public_seed, int x) inline {
    return cell_hash(
        begin_cell()
            .store_uint(tag::wots_chain, 32)
            .store_uint(public_seed, 256)
            .store_uint(x, 256)
        .end_cell()
    );
}

int chain_iter(int public_seed, int x, int steps) inline {
    int i = 0;
    while (i < steps) {
        x = chain_step(public_seed, x);
        i += 1;
    }
    return x;
}

int rand_hash(int left, int right) inline {
    return cell_hash(
        begin_cell()
            .store_uint(tag::merkle, 32)
            .store_uint(left, 256)
            .store_uint(right, 256)
        .end_cell()
    );
}

int ltree_hash(int left, int right) inline {
    return cell_hash(
        begin_cell()
            .store_uint(tag::ltree, 32)
            .store_uint(left, 256)
            .store_uint(right, 256)
        .end_cell()
    );
}

int hash_message(cell payload, int req_type, int auth_mode, int auth_key) inline {
    int addr_hash = cell_hash(
        begin_cell()
            .store_slice(my_address())
        .end_cell()
    );

    return cell_hash(
        begin_cell()
            .store_uint(tag::xmss_msg, 32)
            .store_uint(addr_hash, 256)
            .store_uint(auth_mode, 8)
            .store_uint(req_type, 8)
            .store_uint(auth_key, 256)
            .store_uint(cell_hash(payload), 256)
        .end_cell()
    );
}

(int, slice) read_word(slice cs) inline {
    if (slice_bits(cs) == 0) {
        throw_unless(err::invalid_proof_format, slice_refs(cs) == 1);
        cs = begin_parse(cs~load_ref());
    }
    throw_unless(err::invalid_proof_format, slice_bits(cs) >= 256);
    return (cs~load_uint(256), cs);
}

(int, slice) verify_wots_plus(slice cs, int public_seed, int msg_hash) inline {
    tuple pks = empty_tuple();
    int sum = 0;
    int i = 0;

    while (i < WOTS_LEN1) {
        int coef = (msg_hash >> ((WOTS_LEN1 - 1 - i) * 4)) & 15;
        sum += coef;
        var (sig, cs2) = read_word(cs);
        cs = cs2;
        pks = tpush(pks, chain_iter(public_seed, sig, WOTS_W - 1 - coef));
        i += 1;
    }

    int csum = WOTS_CSUM_MAX - sum;
    int j = 0;
    while (j < WOTS_LEN2) {
        int coef = (csum >> ((WOTS_LEN2 - 1 - j) * 4)) & 15;
        var (sig, cs2) = read_word(cs);
        cs = cs2;
        pks = tpush(pks, chain_iter(public_seed, sig, WOTS_W - 1 - coef));
        j += 1;
    }

    int sz = WOTS_LEN;
    while (sz > 1) {
        tuple next = empty_tuple();
        int k = 0;
        while (k + 1 < sz) {
            next = tpush(next, ltree_hash(pks.at(k), pks.at(k + 1)));
            k += 2;
        }
        if (k < sz) {
            next = tpush(next, pks.at(k));
        }
        pks = next;
        sz = (sz + 1) >> 1;
    }

    return (pks.at(0), cs);
}

int verify_merkle_path(slice cs, int leaf, int idx, int root) inline {
    int node = leaf;
    int pos  = idx;

    repeat(TREE_HEIGHT) {
        var (sib, cs2) = read_word(cs);
        cs = cs2;
        node = (pos & 1) ? rand_hash(sib, node) : rand_hash(node, sib);
        pos >>= 1;
    }

    throw_unless(err::invalid_proof_format, slice_bits(cs) == 0);
    throw_unless(err::invalid_proof_format, slice_refs(cs) == 0);
    throw_unless(err::invalid_signature, node == root);

    return -1;
}

int verify_xmss(
    cell payload,
    cell proof,
    int root,
    int public_seed,
    int expected_idx,
    int req_type,
    int auth_mode,
    int auth_key
) inline {
    slice cs = begin_parse(proof);

    throw_unless(err::invalid_proof_format, slice_bits(cs) >= (8 + 64 + 256));
    throw_unless(err::invalid_proof_format, slice_refs(cs) <= 1);

    int version = cs~load_uint(8);
    throw_unless(err::invalid_proof_format, version == PROOF_VERSION);

    int idx = cs~load_uint(64);
    throw_unless(err::invalid_leaf_index, idx == expected_idx);

    int proof_pub_seed = cs~load_uint(256);
    throw_unless(err::invalid_signature, proof_pub_seed == public_seed);

    var (leaf, cs2) = verify_wots_plus(cs, public_seed, hash_message(payload, req_type, auth_mode, auth_key));
    return verify_merkle_path(cs2, leaf, idx, root);
}

;; ── blinded keys ─────────────────────────────────────────────

() validate_blinded_key(int key_hash, cell blinded_dict) impure inline {
    throw_if(err::invalid_blinded_key, cell_null?(blinded_dict));
    var (_, found) = udict_get?(blinded_dict, BLINDED_KEY_BITS, key_hash);
    throw_unless(err::invalid_blinded_key, found);
}

cell consume_blinded_key(cell blinded_dict, int blinded_preimage) impure inline {
    int key_hash = commit_blinded_key(blinded_preimage);
    var (new_dict, _) = udict_delete?(blinded_dict, BLINDED_KEY_BITS, key_hash);
    return new_dict;
}

;; Count entries in a udict — used ONLY in rotate_root (post-accept)
;; to verify the newly supplied blinded_dict matches new_blinded_count.
;; Never called from load_storage or pre-accept paths.
int udict_count(cell d, int key_bits) inline {
    if (cell_null?(d)) { return 0; }
    int cnt = 0;
    var (k, _, found) = udict_get_min?(d, key_bits);
    while (found) {
        cnt += 1;
        var (k2, _, found2) = udict_get_next?(d, key_bits, k);
        k     = k2;
        found = found2;
    }
    return cnt;
}

;; ── storage ──────────────────────────────────────────────────
;;
;; Layout (version = 3):
;;   uint8   version
;;   uint32  seqno
;;   uint32  wallet_id
;;   uint256 policy
;;   uint256 root
;;   uint256 pub_seed
;;   uint32  limit
;;   uint32  next_leaf
;;   uint32  blinded_remaining   ;; trusted counter, kept in sync by contract logic
;;   uint32  ext_lock_until      ;; externals rejected while now() < ext_lock_until
;;   ref[0]: wl_dict
;;   ref[1]: blinded_dict

const int STORAGE_VERSION = 3;

(int, int, int, int, int, int, int, int, int, cell, cell) load_storage() inline {
    slice a = begin_parse(get_data());

    throw_unless(err::bad_storage, slice_refs(a) == 2);

    int version = a~load_uint(8);
    throw_unless(err::bad_storage, version == STORAGE_VERSION);

    int seqno             = a~load_uint(32);
    int wallet_id         = a~load_uint(32);
    int policy            = a~load_uint(256);
    int root              = a~load_uint(256);
    int pub_seed          = a~load_uint(256);
    int limit             = a~load_uint(32);
    int next_leaf         = a~load_uint(32);
    int blinded_remaining = a~load_uint(32);
    int ext_lock_until    = a~load_uint(32);

    throw_unless(err::bad_storage, slice_bits(a) == 0);

    cell wl_box      = a~load_ref();
    cell blinded_box = a~load_ref();

    slice wl_slice      = begin_parse(wl_box);
    slice blinded_slice = begin_parse(blinded_box);

    var (wl_rem, wl_dict)      = wl_slice.load_dict();
    var (bl_rem, blinded_dict) = blinded_slice.load_dict();

    throw_unless(err::bad_storage, wl_rem.slice_empty?());
    throw_unless(err::bad_storage, bl_rem.slice_empty?());

    throw_unless(err::bad_storage, next_leaf <= limit);
    throw_unless(err::bad_storage, limit <= TREE_MAX_LEAVES);

    return (seqno, wallet_id, policy, root, pub_seed, limit, next_leaf, blinded_remaining,
            ext_lock_until, wl_dict, blinded_dict);
}

() save_storage(
    int seqno, int wallet_id, int policy,
    int root, int pub_seed, int limit, int next_leaf,
    int blinded_remaining, int ext_lock_until,
    cell wl_dict, cell blinded_dict
) impure inline {
    set_data(
        begin_cell()
            .store_uint(STORAGE_VERSION, 8)
            .store_uint(seqno, 32)
            .store_uint(wallet_id, 32)
            .store_uint(policy, 256)
            .store_uint(root, 256)
            .store_uint(pub_seed, 256)
            .store_uint(limit, 32)
            .store_uint(next_leaf, 32)
            .store_uint(blinded_remaining, 32)
            .store_uint(ext_lock_until, 32)
            .store_ref(
                begin_cell().store_dict(wl_dict).end_cell()
            )
            .store_ref(
                begin_cell().store_dict(blinded_dict).end_cell()
            )
        .end_cell()
    );
}

;; ── whitelist helpers ─────────────────────────────────────────

int wl_key(slice addr) inline {
    var (wc, ah) = parse_std_addr(addr);
    return cell_hash(
        begin_cell()
            .store_uint(tag::wl_key, 32)
            .store_int(wc, 8)
            .store_uint(ah, 256)
        .end_cell()
    );
}

int wl_contains(cell wl_dict, slice addr) inline {
    if (cell_null?(wl_dict)) { return 0; }
    var (_, found) = udict_get?(wl_dict, WL_KEY_BITS, wl_key(addr));
    return found;
}

cell wl_set(cell wl_dict, slice addr) inline {
    return udict_set(wl_dict, WL_KEY_BITS, wl_key(addr), begin_cell().end_cell().begin_parse());
}

cell wl_del(cell wl_dict, slice addr) inline {
    var (new_dict, _) = udict_delete?(wl_dict, WL_KEY_BITS, wl_key(addr));
    return new_dict;
}

;; ── misc validation ───────────────────────────────────────────

() validate_send_mode(int mode) impure inline {
    int ok = (mode == 0) | (mode == 1) | (mode == 2) |
             (mode == 64) | (mode == 65) | (mode == 66);
    throw_unless(err::bad_mode, ok);
}

;; Everything that can be decided without the WOTS+ signature.
;; Cheap enough to run before accept_message.
() check_common(
    int wallet_id_in, int valid_until, int seqno_in, int policy_in, int req_type,
    int wid, int seqno, int policy, int limit, int next_leaf, int blinded_remaining
) impure inline {
    throw_unless(err::invalid_seqno, seqno_in     == seqno);
    throw_unless(err::invalid_wallet_id, wallet_id_in == wid);
    throw_unless(err::expired, valid_until  > now());
    throw_unless(err::expired, valid_until  <= now() + MAX_VALID_UNTIL_DELTA);
    throw_unless(err::policy_mismatch, policy_in    == policy);
    throw_unless(err::invalid_op, req_type     <= req::wl_remove);

    throw_unless(err::wallet_exhausted, next_leaf < limit);
    throw_unless(err::invalid_blinded_key, blinded_remaining > 0);
    ;; The last leaf / blinded key can only be spent on rotate_root,
    ;; otherwise the wallet could never sign again (funds frozen).
    ifnot (req_type == req::rotate_root) {
        throw_unless(err::leaf_reserved, next_leaf + 1 < limit);
        throw_unless(err::leaf_reserved, blinded_remaining > 1);
    }
}

;; ── body parser ───────────────────────────────────────────────

(cell, cell, slice, int, int, int, int, int, int) parse_body(slice body, int expected_op) inline {
    throw_unless(err::invalid_op, slice_bits(body) >= 32);
    throw_unless(err::invalid_op, body~load_uint(32) == expected_op);

    throw_unless(err::invalid_op, slice_refs(body) >= 2);
    cell proof   = body~load_ref();
    cell payload = body~load_ref();
    throw_unless(err::invalid_op, slice_bits(body) == 0);
    throw_unless(err::invalid_op, slice_refs(body) == 0);

    slice ps = begin_parse(payload);
    throw_unless(err::invalid_op, slice_bits(ps) >= (32 + 32 + 32 + 256 + 8 + 256));

    int wallet_id        = ps~load_uint(32);
    int valid_until      = ps~load_uint(32);
    int seqno_in         = ps~load_uint(32);
    int policy_in        = ps~load_uint(256);
    int req_type         = ps~load_uint(8);
    int blinded_preimage = ps~load_uint(256);

    return (proof, payload, ps, wallet_id, valid_until, seqno_in, policy_in, req_type, blinded_preimage);
}

;; ── request handler ───────────────────────────────────────────
;;
;; Called after all cheap checks passed. Verifies the signature and executes.
;; On success writes the final state with seqno + 1, next_leaf + 1, the blinded
;; key consumed and the external lock cleared, then commits.

() handle_request(
    cell proof, cell payload, slice ps,
    int req_type,
    int blinded_preimage,
    int seqno, int wid, int policy,
    int root, int pub_seed, int limit, int next_leaf,
    int blinded_remaining,
    cell wl_dict,
    cell blinded_dict,
    int auth_mode,
    int auth_key
) impure {

    cell next_blinded_dict      = consume_blinded_key(blinded_dict, blinded_preimage);
    int  next_blinded_remaining = blinded_remaining - 1;

    throw_unless(err::invalid_signature, verify_xmss(payload, proof, root, pub_seed, next_leaf, req_type, auth_mode, auth_key) == -1);

    int new_seqno = seqno + 1;
    int new_next  = next_leaf + 1;

    if (req_type == req::transfer) {
        throw_unless(err::invalid_op, slice_bits(ps) >= 8);
        int mode = ps~load_uint(8);
        validate_send_mode(mode);
        throw_unless(err::invalid_op, slice_refs(ps) == 1);
        cell out_msg = ps~load_ref();
        throw_unless(err::invalid_op, slice_bits(ps) == 0);
        throw_unless(err::invalid_op, slice_refs(ps) == 0);

        send_raw_message(out_msg, mode);
        save_storage(new_seqno, wid, policy, root, pub_seed, limit, new_next,
                     next_blinded_remaining, 0, wl_dict, next_blinded_dict);
        commit();

    } elseif (req_type == req::rotate_root) {
        ;;
        ;; ref new_tree_data layout:
        ;;   uint256  new_root
        ;;   uint256  new_pub_seed
        ;;   uint32   new_limit
        ;;   uint256  new_policy
        ;;   uint32   new_blinded_count   ;; must equal actual dict entry count
        ;;   ref      new_blinded_box     ;; begin_cell().store_dict(new_blinded_dict).end_cell()
        ;;
        throw_unless(err::invalid_op, slice_refs(ps) == 1);
        slice nd = ps~load_ref().begin_parse();
        throw_unless(err::invalid_op, slice_bits(nd) >= (256 + 256 + 32 + 256 + 32));

        int new_root          = nd~load_uint(256);
        int new_pub_seed      = nd~load_uint(256);
        int new_limit         = nd~load_uint(32);
        int new_policy        = nd~load_uint(256);
        int new_blinded_count = nd~load_uint(32);

        throw_unless(err::invalid_op, slice_refs(nd) == 1);
        cell new_blinded_box = nd~load_ref();
        throw_unless(err::invalid_op, slice_bits(nd) == 0);
        throw_unless(err::invalid_op, slice_bits(ps) == 0);
        throw_unless(err::invalid_op, slice_refs(ps) == 0);

        slice bl_sl = begin_parse(new_blinded_box);
        var (bl_rem2, new_blinded_dict) = bl_sl.load_dict();
        throw_unless(err::invalid_op, bl_rem2.slice_empty?());

        ;; Post-accept: verify counter matches the actual new dict
        int real_new_count = udict_count(new_blinded_dict, BLINDED_KEY_BITS);
        throw_unless(err::invalid_blinded_key, new_blinded_count == real_new_count);

        ;; A new tree needs at least two leaves (one to use, one reserved for the
        ;; next rotation) and a blinded key for every leaf.
        throw_unless(err::wallet_exhausted, new_limit >= 2);
        throw_unless(err::wallet_exhausted, new_limit <= TREE_MAX_LEAVES);
        throw_unless(err::invalid_blinded_key, new_blinded_count >= new_limit);

        ;; next_leaf resets to 0; blinded_dict fully replaced
        save_storage(new_seqno, wid, new_policy, new_root, new_pub_seed, new_limit, 0,
                     new_blinded_count, 0, wl_dict, new_blinded_dict);
        commit();

    } elseif (req_type == req::wl_add) {
        throw_unless(err::invalid_op, slice_bits(ps) == 0);
        throw_unless(err::invalid_op, slice_refs(ps) == 1);
        slice addr = begin_parse(ps~load_ref());
        _ = wl_key(addr);
        save_storage(new_seqno, wid, policy, root, pub_seed, limit, new_next,
                     next_blinded_remaining, 0, wl_set(wl_dict, addr), next_blinded_dict);
        commit();

    } elseif (req_type == req::wl_remove) {
        throw_unless(err::invalid_op, slice_bits(ps) == 0);
        throw_unless(err::invalid_op, slice_refs(ps) == 1);
        slice addr = begin_parse(ps~load_ref());
        _ = wl_key(addr);
        save_storage(new_seqno, wid, policy, root, pub_seed, limit, new_next,
                     next_blinded_remaining, 0, wl_del(wl_dict, addr), next_blinded_dict);
        commit();

    } else {
        throw(err::invalid_op);
    }
}

;; ── recv_external ─────────────────────────────────────────────

() recv_external(slice in_msg) impure {
    if (ALLOW_EXTERNAL == 0) { return (); }

    if (slice_bits(in_msg) < 32) { return (); }
    if (in_msg.preload_uint(32) != op::signed_external) { return (); }

    var (proof, payload, ps, wallet_id_in, valid_until, seqno_in, policy_in, req_type, blinded_preimage)
        = parse_body(in_msg, op::signed_external);

    var (seqno, wid, policy, root, pub_seed, limit, next_leaf, blinded_remaining, ext_lock_until,
         wl_dict, blinded_dict) = load_storage();

    ;; ── pre-accept: nothing here costs the wallet anything ──
    throw_unless(err::externals_locked, now() >= ext_lock_until);

    check_common(wallet_id_in, valid_until, seqno_in, policy_in, req_type,
                 wid, seqno, policy, limit, next_leaf, blinded_remaining);

    {
        slice cs = begin_parse(proof);
        throw_unless(err::invalid_proof_format, slice_bits(cs) >= (8 + 64 + 256));
        throw_unless(err::invalid_proof_format, slice_refs(cs) <= 1);
        throw_unless(err::invalid_proof_format, cs~load_uint(8)   == PROOF_VERSION);
        throw_unless(err::invalid_leaf_index, cs~load_uint(64)  == next_leaf);
        throw_unless(err::invalid_signature, cs~load_uint(256) == pub_seed);
    }

    int blinded_key_hash = commit_blinded_key(blinded_preimage);
    validate_blinded_key(blinded_key_hash, blinded_dict);

    accept_message();

    ;; ── burn the attempt before the expensive part ──
    ;; If verification (or anything after it) throws, or runs out of gas, the state
    ;; committed here survives: the message cannot be replayed and the leaf that
    ;; was published is never reused for another digest.
    if (next_leaf + 1 < limit) {
        save_storage(seqno + 1, wid, policy, root, pub_seed, limit, next_leaf + 1,
                     blinded_remaining - 1, 0, wl_dict,
                     consume_blinded_key(blinded_dict, blinded_preimage));
    } else {
        ;; Last leaf (rotate_root only): never burned, so the wallet can always
        ;; rotate. Instead lock externals until this message expires — the leaked
        ;; header becomes useless before the lock lifts.
        save_storage(seqno, wid, policy, root, pub_seed, limit, next_leaf,
                     blinded_remaining, valid_until, wl_dict, blinded_dict);
    }
    commit();

    handle_request(
        proof, payload, ps,
        req_type,
        blinded_preimage,
        seqno, wid, policy, root, pub_seed, limit, next_leaf,
        blinded_remaining,
        wl_dict, blinded_dict,
        AUTH_EXTERNAL,
        blinded_key_hash
    );
}

;; ── recv_internal ─────────────────────────────────────────────
;;
;; Relayed requests from whitelisted addresses. The relayer pays the gas
;; (no accept_message), a failure bounces and leaves the state untouched.
;; Not affected by ext_lock_until.

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
    slice hdr = begin_parse(in_msg_full);
    int flags = hdr~load_uint(4);

    if (flags & 1) { return (); }  ;; bounced

    slice sender_raw = hdr~load_msg_addr();

    if (slice_bits(in_msg_body) < 32) { return (); }
    if (in_msg_body.preload_uint(32) != op::signed_internal) { return (); }

    throw_unless(err::insufficient_value, msg_value >= MIN_INTERNAL_MSG_VALUE);

    var (seqno, wid, policy, root, pub_seed, limit, next_leaf, blinded_remaining, _,
         wl_dict, blinded_dict) = load_storage();

    if (cell_null?(wl_dict)) { throw(err::not_whitelisted); }
    throw_unless(err::not_whitelisted, wl_contains(wl_dict, sender_raw));

    var (proof, payload, ps, wallet_id_in, valid_until, seqno_in, policy_in, req_type, blinded_preimage)
        = parse_body(in_msg_body, op::signed_internal);

    check_common(wallet_id_in, valid_until, seqno_in, policy_in, req_type,
                 wid, seqno, policy, limit, next_leaf, blinded_remaining);
    int blinded_key_hash = commit_blinded_key(blinded_preimage);
    validate_blinded_key(blinded_key_hash, blinded_dict);

    handle_request(
        proof, payload, ps,
        req_type,
        blinded_preimage,
        seqno, wid, policy, root, pub_seed, limit, next_leaf,
        blinded_remaining,
        wl_dict, blinded_dict,
        AUTH_INTERNAL,
        blinded_key_hash
    );
}

;; ── GET methods ───────────────────────────────────────────────

int seqno() method_id {
    var (seqno, _, _, _, _, _, _, _, _, _, _) = load_storage();
    return seqno;
}

int get_wallet_id() method_id {
    var (_, wid, _, _, _, _, _, _, _, _, _) = load_storage();
    return wid;
}

int get_policy_hash() method_id {
    var (_, _, policy, _, _, _, _, _, _, _, _) = load_storage();
    return policy;
}

int get_root() method_id {
    var (_, _, _, root, _, _, _, _, _, _, _) = load_storage();
    return root;
}

int get_public_seed() method_id {
    var (_, _, _, _, pub_seed, _, _, _, _, _, _) = load_storage();
    return pub_seed;
}

int get_leaf_limit() method_id {
    var (_, _, _, _, _, limit, _, _, _, _, _) = load_storage();
    return limit;
}

int get_next_leaf() method_id {
    var (_, _, _, _, _, _, next_leaf, _, _, _, _) = load_storage();
    return next_leaf;
}

int get_leaves_remaining() method_id {
    var (_, _, _, _, _, limit, next_leaf, _, _, _, _) = load_storage();
    return limit - next_leaf;
}

int get_tree_height() method_id {
    return TREE_HEIGHT;
}

int is_whitelisted(slice addr) method_id {
    var (_, _, _, _, _, _, _, _, _, wl_dict, _) = load_storage();
    if (cell_null?(wl_dict)) { return 0; }
    return wl_contains(wl_dict, addr);
}

int get_blinded_keys_remaining() method_id {
    var (_, _, _, _, _, _, _, blinded_remaining, _, _, _) = load_storage();
    return blinded_remaining;
}

int get_external_lock_until() method_id {
    var (_, _, _, _, _, _, _, _, ext_lock_until, _, _) = load_storage();
    return ext_lock_until;
}
