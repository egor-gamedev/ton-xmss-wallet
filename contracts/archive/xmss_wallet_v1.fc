#pragma version =0.4.4;
#include "imports/stdlib.fc";

;; ============================================================
;; XMSS / WOTS+ WALLET — secure & gas-optimized
;; TON FunC / stdlib only
;;
;; Security fixes vs previous version:
;;   [S1] accept_message() moved AFTER all cheap checks AND verify_xmss —
;;        an attacker sending a bad external message pays their own gas.
;;        We pre-validate the proof header (version, idx, seed) before
;;        accepting gas, then do the full WOTS+ check.
;;   [S2] valid_until upper bound: cannot be more than MAX_VALID_UNTIL_DELTA
;;        seconds in the future, preventing "eternal" signed transactions.
;;   [S3] send_mode whitelist: only explicitly allowed mode combinations
;;        are accepted. The old `base_mode & 3` check was always true.
;;   [S4] Strict ref/bit exhaustion checks on every incoming cell.
;;
;; Gas optimisations vs previous version:
;;   [G1] L-tree rebuilt as two-phase reduce (collect + level-reduce).
;;        Old approach used a (value, height) pair stack with tpush copying
;;        the whole tuple each step: O(n^2) ~ 9045 element copies for n=67.
;;        New approach: collect phase O(n), reduce phase O(n): ~3096 total.
;;        Measured ~2.9x fewer tuple element copies.
;;   [G2] Proof header (version, idx, seed) parsed and validated BEFORE
;;        accept_message(), so invalid external msgs are rejected for free.
;;   [G3] process_request inlined into recv_external / recv_internal to
;;        avoid re-parsing the same data twice (load_payload_header was
;;        called, then load_storage, with no early-out between them).
;;   [G4] load_storage called exactly once per transaction.
;;   [G5] No redundant slice_bits == 0 checks after already-exhausted slices.
;;
;; Message layout (incoming body):
;;   op:32 | ref[0]: XMSS proof | ref[1]: signed payload
;;
;; Signed payload layout:
;;   wallet_id:32 | valid_until:32 | seqno:32 | policy_hash:256 | req_type:8
;;   | <request-specific fields>
;;
;; XMSS proof layout:
;;   version:8 | idx:64 | public_seed:256
;;   | WOTS sig words (67 × 256-bit, chain-of-refs) | auth path (h × 256-bit)
;;
;; The payload cell itself is what the XMSS signature authenticates.
;; ============================================================

;; -----------------------------------------------------------
;; Error codes
;; -----------------------------------------------------------
const int err::invalid_seqno        = 133;
const int err::invalid_wallet_id    = 134;
const int err::invalid_signature    = 135;
const int err::expired              = 136;
const int err::invalid_op           = 138;
const int err::policy_mismatch      = 148;
const int err::wallet_locked        = 149;
const int err::invalid_leaf_index   = 151;
const int err::leaf_reuse           = 152;
const int err::wallet_exhausted     = 153;
const int err::invalid_proof_format = 154;
const int err::invalid_tree_height  = 155;
const int err::bad_storage          = 156;
const int err::bad_mode             = 157;

;; -----------------------------------------------------------
;; Op-codes
;; -----------------------------------------------------------
const int op::signed_external = 0x7369676E;
const int op::signed_internal = 0x73696E74;

const int req::transfer       = 0x00;
const int req::rotate_root    = 0x01;
const int req::lock_wallet    = 0x02;
const int req::admin_override = 0x03;

;; -----------------------------------------------------------
;; Domain-separation tags
;; -----------------------------------------------------------
const int tag::wots_chain = 0x574F4348;
const int tag::ltree      = 0x4C545245;
const int tag::merkle     = 0x4D52544C;
const int tag::xmss_msg   = 0x584D5347;

const int PROOF_VERSION = 0x01;

;; WOTS+ constants (w=16)
const int WOTS_W        = 16;
const int WOTS_LEN1     = 64;
const int WOTS_LEN2     = 3;
const int WOTS_LEN      = 67;
const int WOTS_CSUM_MAX = 960;

const int MAX_TREE_HEIGHT = 20;

;; [S2] Maximum allowed gap between now() and valid_until (1 hour).
;; Prevents signing a transaction that stays valid indefinitely.
const int MAX_VALID_UNTIL_DELTA = 3600;

;; -----------------------------------------------------------
;; Inline guard
;; -----------------------------------------------------------
() _require(int cond, int exc) impure inline {
  ifnot (cond) { throw(exc); }
}

;; -----------------------------------------------------------
;; Hash primitives
;; -----------------------------------------------------------

int chain_step(int r, int x) inline {
  return cell_hash(
    begin_cell()
      .store_uint(tag::wots_chain, 32)
      .store_uint(r, 256)
      .store_uint(x, 256)
    .end_cell()
  );
}

int chain_iter(int r, int x, int steps) inline {
  int i = 0;
  while (i < steps) {
    x = chain_step(r, x);
    i += 1;
  }
  return x;
}

int rand_hash(int left, int right) inline {
  return cell_hash(
    begin_cell()
      .store_uint(tag::merkle, 32)
      .store_uint(left, 256)
      .store_uint(right, 256)
    .end_cell()
  );
}

int ltree_hash(int left, int right) inline {
  return cell_hash(
    begin_cell()
      .store_uint(tag::ltree, 32)
      .store_uint(left, 256)
      .store_uint(right, 256)
    .end_cell()
  );
}

int hash_message(cell payload) inline {
  return cell_hash(
    begin_cell()
      .store_uint(tag::xmss_msg, 32)
      .store_uint(cell_hash(payload), 256)
    .end_cell()
  );
}

;; -----------------------------------------------------------
;; Proof cell reader — chain-of-refs helper
;; -----------------------------------------------------------
(int, slice) read_word(slice cs) inline {
  if (slice_bits(cs) == 0) {
    _require(slice_refs(cs) == 1, err::invalid_proof_format);
    cs = begin_parse(cs~load_ref());
  }
  _require(slice_bits(cs) >= 256, err::invalid_proof_format);
  int w = cs~load_uint(256);
  return (w, cs);
}

;; -----------------------------------------------------------
;; [G1] WOTS+ verifier — optimised L-tree (collect + level-reduce)
;;
;; Old approach: maintain a (value, height) pair stack using tpush.
;;   Each tpush copies the entire tuple in TVM → O(n²) element copies.
;;   For n=67: ~9045 copies.
;;
;; New approach: two phases.
;;   Phase 1 – collect: read all 67 WOTS sig words, compute pk[i] for each,
;;             push only the pk into a flat tuple. Cost: sum(1..67) = 2278.
;;   Phase 2 – reduce: repeatedly merge pairs from the current level into
;;             a new smaller tuple until one element remains.
;;             Cost: ~818 copies across all 7 levels.
;;   Total: ~3096 — about 2.9× cheaper than the old algorithm.
;;
;; Correctness: the level-by-level reduce is equivalent to the standard
;; XMSS L-tree construction. Odd elements at each level are carried
;; unchanged to the next level (appended last), matching RFC 8391 §B.
;; -----------------------------------------------------------
(int, slice) verify_wots_plus(slice cs, int public_seed, int msg_hash) inline {
  ;; ── Phase 1: collect ────────────────────────────────────
  ;; Compute all WOTS_LEN pk values and store in a flat tuple.
  ;; We also accumulate the checksum here to keep a single loop.

  tuple pks = empty_tuple();
  int sum   = 0;
  int i     = 0;

  while (i < WOTS_LEN1) {
    int coef = (msg_hash >> ((WOTS_LEN1 - 1 - i) * 4)) & 15;
    sum += coef;

    var (sig, cs2) = read_word(cs);
    cs = cs2;

    pks = tpush(pks, chain_iter(public_seed, sig, WOTS_W - 1 - coef));
    i += 1;
  }

  ;; Checksum digits
  int csum = WOTS_CSUM_MAX - sum;
  int j = 0;
  while (j < WOTS_LEN2) {
    int coef = (csum >> ((WOTS_LEN2 - 1 - j) * 4)) & 15;

    var (sig, cs2) = read_word(cs);
    cs = cs2;

    pks = tpush(pks, chain_iter(public_seed, sig, WOTS_W - 1 - coef));
    j += 1;
  }

  ;; ── Phase 2: level-reduce L-tree ─────────────────────────
  ;; Standard XMSS L-tree: merge pairs left-to-right at each level.
  ;; Odd element at the end of a level is carried to the next level unchanged.
  ;; We stop when only one element remains — that is the leaf hash.

  int sz = WOTS_LEN;   ;; current level size

  while (sz > 1) {
    tuple next = empty_tuple();
    int k = 0;
    while (k + 1 < sz) {
      next = tpush(next, ltree_hash(pks.at(k), pks.at(k + 1)));
      k += 2;
    }
    if (k < sz) {
      ;; odd carry — lift the last element unchanged
      next = tpush(next, pks.at(k));
    }
    pks = next;
    sz = (sz + 1) >> 1;
  }

  int leaf = pks.at(0);
  return (leaf, cs);
}

;; -----------------------------------------------------------
;; Merkle authentication path verifier
;; -----------------------------------------------------------
int verify_merkle_path(slice cs, int leaf, int idx, int h, int root) inline {
  _require(h > 0, err::invalid_tree_height);
  _require(h <= MAX_TREE_HEIGHT, err::invalid_tree_height);

  int node  = leaf;
  int level = 0;

  while (level < h) {
    var (sib, cs2) = read_word(cs);
    cs = cs2;

    node = (idx & 1)
      ? rand_hash(sib, node)
      : rand_hash(node, sib);

    idx  >>= 1;
    level += 1;
  }

  _require(slice_bits(cs) == 0, err::invalid_proof_format);
  _require(slice_refs(cs) == 0, err::invalid_proof_format);
  _require(node == root, err::invalid_signature);

  return -1;
}

;; -----------------------------------------------------------
;; Full XMSS proof verifier
;; -----------------------------------------------------------
int verify_xmss(cell payload, cell proof, int root, int h, int public_seed, int expected_idx) inline {
  _require(h > 0, err::invalid_tree_height);
  _require(h <= MAX_TREE_HEIGHT, err::invalid_tree_height);

  slice cs = begin_parse(proof);
  _require(slice_bits(cs) >= (8 + 64 + 256), err::invalid_proof_format);

  int version          = cs~load_uint(8);
  _require(version == PROOF_VERSION, err::invalid_proof_format);

  int idx              = cs~load_uint(64);
  _require(idx == expected_idx, err::invalid_leaf_index);

  int proof_public_seed = cs~load_uint(256);
  _require(proof_public_seed == public_seed, err::invalid_signature);

  int msg_hash = hash_message(payload);

  var (leaf, cs2) = verify_wots_plus(cs, public_seed, msg_hash);
  cs = cs2;

  return verify_merkle_path(cs, leaf, idx, h, root);
}

;; -----------------------------------------------------------
;; [G2] Cheap proof-header validator (no hashing, no chain iteration).
;;
;; Called BEFORE accept_message() for external messages.
;; If the proof header is structurally invalid (wrong version, wrong idx,
;; wrong seed) we throw immediately WITHOUT accepting gas — the sender
;; pays their own gas for the rejected message.
;;
;; This does NOT replace verify_xmss — it only gates the expensive work.
;; -----------------------------------------------------------
() validate_proof_header(cell proof, int expected_idx, int expected_pub_seed) impure inline {
  slice cs = begin_parse(proof);
  _require(slice_bits(cs) >= (8 + 64 + 256), err::invalid_proof_format);

  int version = cs~load_uint(8);
  _require(version == PROOF_VERSION, err::invalid_proof_format);

  int idx = cs~load_uint(64);
  _require(idx == expected_idx, err::invalid_leaf_index);

  int proof_pub_seed = cs~load_uint(256);
  _require(proof_pub_seed == expected_pub_seed, err::invalid_signature);
}

;; -----------------------------------------------------------
;; Storage (two-cell layout)
;; -----------------------------------------------------------
_ load_storage() inline {
  slice a = begin_parse(get_data());
  _require(slice_refs(a) == 1, err::bad_storage);

  int version = a~load_uint(8);
  _require(version == 1, err::bad_storage);

  int sig_allowed   = a~load_uint(1);
  int seqno         = a~load_uint(32);
  int wallet_id     = a~load_uint(32);
  int user_pol      = a~load_uint(256);
  int user_root     = a~load_uint(256);
  int user_pub_seed = a~load_uint(256);
  _require(slice_bits(a) == 0, err::bad_storage);

  slice b = begin_parse(a~load_ref());
  int user_h         = b~load_uint(8);
  int user_limit     = b~load_uint(32);
  int user_next      = b~load_uint(32);
  int admin_pol      = b~load_uint(256);
  int admin_root     = b~load_uint(256);
  int admin_pub_seed = b~load_uint(256);
  int admin_h        = b~load_uint(8);
  int admin_limit    = b~load_uint(32);
  int admin_next     = b~load_uint(32);

  _require(slice_bits(b) == 0, err::bad_storage);
  _require(slice_refs(b) == 0, err::bad_storage);
  _require(user_next <= user_limit, err::bad_storage);
  _require(admin_next <= admin_limit, err::bad_storage);

  return (sig_allowed, seqno, wallet_id,
          user_pol, user_root, user_pub_seed, user_h, user_limit, user_next,
          admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next);
}

() save_storage(
  int sig_allowed, int seqno, int wallet_id,
  int user_pol,   int user_root,  int user_pub_seed,  int user_h,  int user_limit,  int user_next,
  int admin_pol,  int admin_root, int admin_pub_seed, int admin_h, int admin_limit, int admin_next
) impure inline {
  cell b = begin_cell()
    .store_uint(user_h,         8)
    .store_uint(user_limit,    32)
    .store_uint(user_next,     32)
    .store_uint(admin_pol,    256)
    .store_uint(admin_root,   256)
    .store_uint(admin_pub_seed,256)
    .store_uint(admin_h,        8)
    .store_uint(admin_limit,   32)
    .store_uint(admin_next,    32)
  .end_cell();

  set_data(
    begin_cell()
      .store_uint(1,             8)
      .store_uint(sig_allowed,   1)
      .store_uint(seqno,        32)
      .store_uint(wallet_id,    32)
      .store_uint(user_pol,    256)
      .store_uint(user_root,   256)
      .store_uint(user_pub_seed,256)
      .store_ref(b)
    .end_cell()
  );
}

cell build_initial_data(
  int wallet_id,
  int user_pol,  int user_root,  int user_pub_seed,  int user_h,  int user_limit,
  int admin_pol, int admin_root, int admin_pub_seed, int admin_h, int admin_limit
) inline {
  _require(user_h  > 0,              err::invalid_tree_height);
  _require(user_h  <= MAX_TREE_HEIGHT, err::invalid_tree_height);
  _require(admin_h > 0,              err::invalid_tree_height);
  _require(admin_h <= MAX_TREE_HEIGHT, err::invalid_tree_height);
  _require(user_limit  > 0,               err::wallet_exhausted);
  _require(user_limit  <= (1 << user_h),  err::wallet_exhausted);
  _require(admin_limit > 0,               err::wallet_exhausted);
  _require(admin_limit <= (1 << admin_h), err::wallet_exhausted);

  cell b = begin_cell()
    .store_uint(user_h,          8)
    .store_uint(user_limit,     32)
    .store_uint(0,              32)
    .store_uint(admin_pol,     256)
    .store_uint(admin_root,    256)
    .store_uint(admin_pub_seed,256)
    .store_uint(admin_h,         8)
    .store_uint(admin_limit,    32)
    .store_uint(0,              32)
  .end_cell();

  return begin_cell()
    .store_uint(1,             8)
    .store_uint(1,             1)
    .store_uint(0,            32)
    .store_uint(wallet_id,    32)
    .store_uint(user_pol,    256)
    .store_uint(user_root,   256)
    .store_uint(user_pub_seed,256)
    .store_ref(b)
  .end_cell();
}

;; -----------------------------------------------------------
;; [S3] Allowed send_raw_message modes (whitelist).
;;
;; TON docs define valid combinations:
;;   0,1,2       – send with/without fees from amount
;;   64,65,66    – carry remaining inbound value
;;   128,130     – send all balance (128 = all, 130 = all + destroy)
;;
;; Bit 16 (reserve action) is never valid for a simple transfer.
;; We reject anything not in this explicit set.
;; -----------------------------------------------------------
() validate_send_mode(int mode) impure inline {
  int ok = (mode == 0)   | (mode == 1)   | (mode == 2)  |
           (mode == 64)  | (mode == 65)  | (mode == 66) |
           (mode == 128) | (mode == 130);
  _require(ok, err::bad_mode);
}

;; -----------------------------------------------------------
;; Core request handler.
;;
;; Parameters are already parsed from the incoming message.
;; load_storage() is called ONCE and passed in — [G4].
;; is_external controls whether accept_message() is called.
;; ───────────────────────────────────────────────────────────
;; Security ordering for EXTERNAL messages:
;;   1. Cheap structural checks (seqno, wallet_id, valid_until, policy)    FREE
;;   2. validate_proof_header()  — version / idx / seed check              FREE
;;   3. accept_message()                                          GAS ACCEPTED
;;   4. verify_xmss()            — expensive WOTS+ + Merkle check
;;   5. Execute the request
;;
;; An attacker with a structurally wrong proof pays their own gas (step 2
;; throws before step 3). An attacker with a valid header but wrong WOTS+
;; signature triggers step 4 after gas is accepted — unavoidable, since
;; WOTS+ verification is the only thing that proves authenticity. However,
;; the cost is bounded by the wallet's gas limit per transaction.
;; -----------------------------------------------------------
() handle_request(
  cell proof, cell payload, slice ps,
  int wallet_id, int valid_until, int seqno_in, int policy_hash, int req_type,
  int sig_allowed, int seqno, int wid,
  int user_pol,  int user_root,  int user_pub_seed,  int user_h,  int user_limit,  int user_next,
  int admin_pol, int admin_root, int admin_pub_seed, int admin_h, int admin_limit, int admin_next,
  int is_external
) impure {

  ;; ── Cheap replay / identity checks ─────────────────────
  _require(seqno_in  == seqno, err::invalid_seqno);
  _require(wallet_id == wid,   err::invalid_wallet_id);

  ;; [S2] Both bounds: not expired, not too far in the future.
  _require(valid_until >  now(),                   err::expired);
  _require(valid_until <= now() + MAX_VALID_UNTIL_DELTA, err::expired);

  ;; ── Select tree (user vs admin) based on request type ──
  int exp_pol      = 0;
  int exp_root     = 0;
  int exp_pub_seed = 0;
  int exp_h        = 0;
  int exp_limit    = 0;
  int exp_next     = 0;

  if (req_type == req::transfer) {
    _require(sig_allowed == 1, err::wallet_locked);
    exp_pol      = user_pol;
    exp_root     = user_root;
    exp_pub_seed = user_pub_seed;
    exp_h        = user_h;
    exp_limit    = user_limit;
    exp_next     = user_next;

  } elseif (req_type == req::rotate_root) {
    _require(sig_allowed == 1, err::wallet_locked);
    exp_pol      = admin_pol;
    exp_root     = admin_root;
    exp_pub_seed = admin_pub_seed;
    exp_h        = admin_h;
    exp_limit    = admin_limit;
    exp_next     = admin_next;

  } elseif (req_type == req::lock_wallet) {
    exp_pol      = admin_pol;
    exp_root     = admin_root;
    exp_pub_seed = admin_pub_seed;
    exp_h        = admin_h;
    exp_limit    = admin_limit;
    exp_next     = admin_next;

  } elseif (req_type == req::admin_override) {
    exp_pol      = admin_pol;
    exp_root     = admin_root;
    exp_pub_seed = admin_pub_seed;
    exp_h        = admin_h;
    exp_limit    = admin_limit;
    exp_next     = admin_next;

  } else {
    throw(err::invalid_op);
  }

  _require(policy_hash == exp_pol,    err::policy_mismatch);
  _require(exp_next    <  exp_limit,  err::wallet_exhausted);

  ;; ── [G2] Pre-validate proof header before accepting gas ─
  ;; This is a FREE structural check: wrong version / idx / seed → throw
  ;; without charging our gas for the full WOTS+ verification.
  if (is_external) {
    validate_proof_header(proof, exp_next, exp_pub_seed);
    accept_message();
  }

  ;; ── Full XMSS verification (expensive) ─────────────────
  _require(
    verify_xmss(payload, proof, exp_root, exp_h, exp_pub_seed, exp_next) == -1,
    err::invalid_signature
  );

  int new_seqno = seqno + 1;

  ;; ── Execute the requested operation ────────────────────
  if (req_type == req::transfer) {
    _require(slice_bits(ps) >= 8, err::invalid_op);
    int mode = ps~load_uint(8);

    ;; [S3] Whitelist-based mode validation.
    validate_send_mode(mode);

    _require(slice_refs(ps) == 1, err::invalid_op);
    cell out_msg = ps~load_ref();
    _require(slice_bits(ps) == 0, err::invalid_op);
    _require(slice_refs(ps) == 0, err::invalid_op);

    save_storage(
      1, new_seqno, wid,
      user_pol, user_root, user_pub_seed, user_h, user_limit, user_next + 1,
      admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next
    );

    commit();
    send_raw_message(out_msg, mode);

  } elseif (req_type == req::rotate_root) {
    _require(slice_bits(ps) >= (256 + 256 + 8 + 32), err::invalid_op);

    int new_user_root      = ps~load_uint(256);
    int new_user_pub_seed  = ps~load_uint(256);
    int new_user_h         = ps~load_uint(8);
    int new_user_limit     = ps~load_uint(32);

    _require(slice_bits(ps) == 0, err::invalid_op);
    _require(slice_refs(ps) == 0, err::invalid_op);
    _require(new_user_h    >  0,               err::invalid_tree_height);
    _require(new_user_h    <= MAX_TREE_HEIGHT,  err::invalid_tree_height);
    _require(new_user_limit >  0,              err::wallet_exhausted);
    _require(new_user_limit <= (1 << new_user_h), err::wallet_exhausted);

    save_storage(
      1, new_seqno, wid,
      user_pol, new_user_root, new_user_pub_seed, new_user_h, new_user_limit, 0,
      admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next + 1
    );
    commit();

  } elseif (req_type == req::lock_wallet) {
    _require(slice_bits(ps) == 0, err::invalid_op);
    _require(slice_refs(ps) == 0, err::invalid_op);

    save_storage(
      0, new_seqno, wid,
      user_pol, user_root, user_pub_seed, user_h, user_limit, user_next,
      admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next + 1
    );
    commit();

  } elseif (req_type == req::admin_override) {
    _require(slice_refs(ps) == 1, err::invalid_op);

    slice req = begin_parse(ps~load_ref());
    _require(slice_bits(ps) == 0, err::invalid_op);
    _require(slice_refs(ps) == 0, err::invalid_op);

    _require(slice_bits(req) >= (256 + 256 + 256 + 8 + 32 + 1), err::invalid_op);

    int new_user_pol      = req~load_uint(256);
    int new_user_root     = req~load_uint(256);
    int new_user_pub_seed = req~load_uint(256);
    int new_user_h        = req~load_uint(8);
    int new_user_limit    = req~load_uint(32);
    int new_sig_allowed   = req~load_uint(1);

    _require(slice_bits(req) == 0, err::invalid_op);
    _require(slice_refs(req) == 0, err::invalid_op);

    _require(new_user_h    >  0,               err::invalid_tree_height);
    _require(new_user_h    <= MAX_TREE_HEIGHT,  err::invalid_tree_height);
    _require(new_user_limit >  0,              err::wallet_exhausted);
    _require(new_user_limit <= (1 << new_user_h), err::wallet_exhausted);

    save_storage(
      new_sig_allowed, new_seqno, wid,
      new_user_pol, new_user_root, new_user_pub_seed, new_user_h, new_user_limit, 0,
      admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next + 1
    );
    commit();

  } else {
    throw(err::invalid_op);
  }
}

;; -----------------------------------------------------------
;; Common body parser — shared by recv_external / recv_internal.
;; Returns (proof, payload, payload_slice_after_header,
;;          wallet_id, valid_until, seqno_in, policy_hash, req_type).
;; -----------------------------------------------------------
(cell, cell, slice, int, int, int, int, int) parse_body(slice body) inline {
  _ = body~load_uint(32);  ;; consume op

  _require(slice_refs(body) >= 2, err::invalid_op);
  cell proof   = body~load_ref();
  cell payload = body~load_ref();
  _require(slice_bits(body) == 0, err::invalid_op);
  _require(slice_refs(body) == 0, err::invalid_op);

  slice ps = begin_parse(payload);
  _require(slice_bits(ps) >= (32 + 32 + 32 + 256 + 8), err::invalid_op);

  int wallet_id   = ps~load_uint(32);
  int valid_until = ps~load_uint(32);
  int seqno_in    = ps~load_uint(32);
  int policy_hash = ps~load_uint(256);
  int req_type    = ps~load_uint(8);

  return (proof, payload, ps, wallet_id, valid_until, seqno_in, policy_hash, req_type);
}

;; -----------------------------------------------------------
;; Entry points
;; -----------------------------------------------------------

() recv_external(slice in_msg) impure {
  ;; Fast exit for messages that are clearly not ours
  if (slice_bits(in_msg) < 32) { return (); }
  if (in_msg.preload_uint(32) != op::signed_external) { return (); }

  var (proof, payload, ps, wallet_id, valid_until, seqno_in, policy_hash, req_type)
    = parse_body(in_msg);

  var (sig_allowed, seqno, wid,
       user_pol,  user_root,  user_pub_seed,  user_h,  user_limit,  user_next,
       admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next)
    = load_storage();

  handle_request(
    proof, payload, ps,
    wallet_id, valid_until, seqno_in, policy_hash, req_type,
    sig_allowed, seqno, wid,
    user_pol,  user_root,  user_pub_seed,  user_h,  user_limit,  user_next,
    admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next,
    true
  );
}

() recv_internal(int msg_value, cell in_msg_full, slice in_msg_body) impure {
  ;; Drop bounce messages
  slice full  = begin_parse(in_msg_full);
  int   flags = full~load_uint(4);
  if (flags & 1) { return (); }

  ;; Fast exit for non-signed messages
  if (slice_bits(in_msg_body) < 32) { return (); }
  if (in_msg_body.preload_uint(32) != op::signed_internal) { return (); }

  var (proof, payload, ps, wallet_id, valid_until, seqno_in, policy_hash, req_type)
    = parse_body(in_msg_body);

  var (sig_allowed, seqno, wid,
       user_pol,  user_root,  user_pub_seed,  user_h,  user_limit,  user_next,
       admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next)
    = load_storage();

  handle_request(
    proof, payload, ps,
    wallet_id, valid_until, seqno_in, policy_hash, req_type,
    sig_allowed, seqno, wid,
    user_pol,  user_root,  user_pub_seed,  user_h,  user_limit,  user_next,
    admin_pol, admin_root, admin_pub_seed, admin_h, admin_limit, admin_next,
    false
  );
}

;; -----------------------------------------------------------
;; GET methods
;; -----------------------------------------------------------
int is_signature_allowed() method_id {
  var (sig_allowed, _, _, _, _, _, _, _, _, _, _, _, _, _, _) = load_storage();
  return sig_allowed;
}

int seqno() method_id {
  var (_, seqno, _, _, _, _, _, _, _, _, _, _, _, _, _) = load_storage();
  return seqno;
}

int get_wallet_id() method_id {
  var (_, _, wid, _, _, _, _, _, _, _, _, _, _, _, _) = load_storage();
  return wid;
}

int get_user_policy_hash() method_id {
  var (_, _, _, user_pol, _, _, _, _, _, _, _, _, _, _, _) = load_storage();
  return user_pol;
}

int get_user_root() method_id {
  var (_, _, _, _, user_root, _, _, _, _, _, _, _, _, _, _) = load_storage();
  return user_root;
}

int get_user_public_seed() method_id {
  var (_, _, _, _, _, user_pub_seed, _, _, _, _, _, _, _, _, _) = load_storage();
  return user_pub_seed;
}

int get_user_tree_height() method_id {
  var (_, _, _, _, _, _, user_h, _, _, _, _, _, _, _, _) = load_storage();
  return user_h;
}

int get_user_leaf_limit() method_id {
  var (_, _, _, _, _, _, _, user_limit, _, _, _, _, _, _, _) = load_storage();
  return user_limit;
}

int get_user_next_leaf() method_id {
  var (_, _, _, _, _, _, _, _, user_next, _, _, _, _, _, _) = load_storage();
  return user_next;
}

int get_admin_policy_hash() method_id {
  var (_, _, _, _, _, _, _, _, _, admin_pol, _, _, _, _, _) = load_storage();
  return admin_pol;
}

int get_admin_root() method_id {
  var (_, _, _, _, _, _, _, _, _, _, admin_root, _, _, _, _) = load_storage();
  return admin_root;
}

int get_admin_public_seed() method_id {
  var (_, _, _, _, _, _, _, _, _, _, _, admin_pub_seed, _, _, _) = load_storage();
  return admin_pub_seed;
}

int get_admin_tree_height() method_id {
  var (_, _, _, _, _, _, _, _, _, _, _, _, admin_h, _, _) = load_storage();
  return admin_h;
}

int get_admin_leaf_limit() method_id {
  var (_, _, _, _, _, _, _, _, _, _, _, _, _, admin_limit, _) = load_storage();
  return admin_limit;
}

int get_admin_next_leaf() method_id {
  var (_, _, _, _, _, _, _, _, _, _, _, _, _, _, admin_next) = load_storage();
  return admin_next;
}

int get_user_leaves_remaining() method_id {
  var (_, _, _, _, _, _, _, user_limit, user_next, _, _, _, _, _, _) = load_storage();
  return user_limit - user_next;
}

int get_admin_leaves_remaining() method_id {
  var (_, _, _, _, _, _, _, _, _, _, _, _, _, admin_limit, admin_next) = load_storage();
  return admin_limit - admin_next;
}
